NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:5173
# Optional local feedback-cycle label. Change it to reopen feedback after a local update.
# FEEDBACK_RELEASE=local-feedback-v1

# Copy the Session pooler connection string from Supabase: Project > Connect.
# Local persistent servers use session mode (5432). Vercel production must use
# the Transaction pooler (6543), DB_POOL_MAX=1 and DB_IDLE_TIMEOUT_MS=1000.
# Replace [YOUR-PASSWORD] and URL-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:5432/postgres
# Keep migrations on a direct/session connection, never transaction mode.
MIGRATION_DATABASE_URL=
DB_SSL=require
# Optional stricter verification: set DB_SSL=verify-full and paste the provider CA.
DB_SSL_CA=
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Verification and password-reset codes are delivered by email.
EMAIL_ENABLED=false

# Gmail example: enable 2-Step Verification, create a Google App Password,
# then use the Gmail address below. Do not use the normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Xlore U <your-sender@gmail.com>

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Use the same Web application client ID in the frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Automatically refresh school profiles and program offerings from configured official pages.
CATALOG_UPDATE_ENABLED=true
CATALOG_UPDATE_INTERVAL_HOURS=168
CATALOG_REQUEST_TIMEOUT_MS=15000
CATALOG_MAX_RESPONSE_BYTES=5000000
CATALOG_MIN_HOST_DELAY_MS=1500
CATALOG_MAX_SOURCES_PER_RUN=20
CATALOG_USER_AGENT=XloreUCatalogUpdater/1.0 (+https://localhost; educational catalog updater)
